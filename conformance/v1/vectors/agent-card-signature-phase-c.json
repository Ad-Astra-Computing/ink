{
  "format": "ink.conformance.v1",
  "category": "agent-card-signature-phase-c",
  "cases": [
    {
      "caseId": "phase-c-on-unsigned-key-derived-reject",
      "description": "With enforcePhaseC on, an unsigned first-contact card for a tulpa: key-derived principal is rejected, even though the profile input is pre-1.0.",
      "input": {
        "card": {
          "protocol": "ink/0.1",
          "agentId": "tulpa:z6Mkon3Necd6NkkyfoGoHxid2znGc59LU3K7mubaRcFbLfLX",
          "handle": "agent",
          "displayName": "Agent",
          "endpoint": "https://example.com/ink",
          "publicKeyMultibase": "z6Mkon3Necd6NkkyfoGoHxid2znGc59LU3K7mubaRcFbLfLX",
          "capabilities": {
            "intentsAccepted": [],
            "intentsSent": []
          },
          "availability": {
            "timezone": "UTC"
          }
        },
        "agentId": "tulpa:z6Mkon3Necd6NkkyfoGoHxid2znGc59LU3K7mubaRcFbLfLX",
        "options": {
          "profile": "pre-1.0",
          "enforcePhaseC": true
        }
      },
      "expect": {
        "result": "reject",
        "reason": "unsigned_key_derived_1_0"
      }
    },
