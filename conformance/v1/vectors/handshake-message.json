      "caseId": "challenge-valid-accepts",
      "description": "A well-formed challenge message validates.",
      "input": {
        "message": {
          "protocol": "ink/0.1",
          "type": "network.tulpa.challenge",
          "intentRef": "intent-1",
          "challengeType": "availability_query",
          "nonce": "n1",
          "timestamp": "2026-06-16T12:00:00.000Z"
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
