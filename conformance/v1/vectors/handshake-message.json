    {
      "caseId": "challenge-with-optional-arrays-accepts",
      "description": "A challenge with optional field/window/context arrays within their caps validates.",
      "input": {
        "message": {
          "protocol": "ink/0.1",
          "type": "network.tulpa.challenge",
          "intentRef": "intent-1",
