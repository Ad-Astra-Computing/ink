      "input": {
        "message": {
          "protocol": "ink/0.1",
          "type": "network.tulpa.rejection",
          "intentRef": "intent-1",
          "reason": "capacity",
          "nonce": "n1",
          "timestamp": "2026-06-16T12:00:00.000Z",
          "detail": "too busy",
          "backoffHint": {
            "retryAfterSeconds": 30,
            "backoffClass": "sender"
          }
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "resolution-with-details-accepts",
