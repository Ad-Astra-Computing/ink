          "nonce": "n1",
          "timestamp": "2026-06-16T12:00:00.000Z",
          "fields": [
            "a",
            "b"
          ],
          "availableWindows": [
            "w1"
          ],
          "contextFields": [
            "c1"
          ]
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "rejection-with-backoff-accepts",
