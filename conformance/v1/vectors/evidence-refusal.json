            "example.claim.t30",
            "example.claim.t31"
          ]
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "wrong-code-rejects",
      "description": "Any code other than policy:evidence_required is not this refusal.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy_violation",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ]
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "error-false-rejects",
      "description": "The error member must be the literal true.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": false,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ]
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "missing-required-claim-types-rejects",
      "description": "A refusal without requiredClaimTypes names nothing the sender can act on.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required"
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "empty-type-set-rejects",
      "description": "An empty set is out of profile; a receiver missing nothing does not refuse for evidence.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
