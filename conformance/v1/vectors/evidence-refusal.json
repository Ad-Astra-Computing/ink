    {
      "caseId": "duplicate-types-rejects",
      "description": "A repeated claim type rejects; the set is distinct and satisfied by type, never by count.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.a.b",
            "example.a.b"
          ]
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "type-grammar-rejects",
      "description": "A type outside the lowercase dotted grammar rejects.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "NoDots"
