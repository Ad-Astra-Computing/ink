{
  "format": "ink.conformance.v1",
  "category": "evidence-refusal",
  "cases": [
    {
      "caseId": "minimal-refusal-accepts",
      "description": "The minimal refusal body: protocol, error, the pinned code and one required claim type.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ]
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "refusal-with-message-accepts",
      "description": "A human-readable message within the 500-code-unit bound is accepted.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ],
          "message": "present example.owner.verified_human evidence"
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "unknown-member-accepts",
      "description": "An unknown member is tolerated for forward compatibility; the sender ignores what it does not model.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ],
          "retryHint": "after-evidence"
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "thirty-two-types-accepts",
      "description": "Thirty-two types sit exactly at the set cap.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.claim.t0",
            "example.claim.t1",
            "example.claim.t2",
            "example.claim.t3",
            "example.claim.t4",
            "example.claim.t5",
            "example.claim.t6",
            "example.claim.t7",
            "example.claim.t8",
            "example.claim.t9",
            "example.claim.t10",
            "example.claim.t11",
