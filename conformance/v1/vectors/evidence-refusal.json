            "example.claim.t13",
            "example.claim.t14",
            "example.claim.t15",
            "example.claim.t16",
            "example.claim.t17",
            "example.claim.t18",
            "example.claim.t19",
            "example.claim.t20",
            "example.claim.t21",
            "example.claim.t22",
            "example.claim.t23",
            "example.claim.t24",
