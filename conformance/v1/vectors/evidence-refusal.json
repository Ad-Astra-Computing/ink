        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            1
          ]
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "over-length-message-rejects",
      "description": "A message longer than 500 code units is out of profile.",
      "input": {
        "refusal": {
          "protocol": "ink/0.1",
          "error": true,
          "code": "policy:evidence_required",
          "requiredClaimTypes": [
            "example.owner.verified_human"
          ],
          "message": ""
