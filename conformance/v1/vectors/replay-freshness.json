{
  "format": "ink.conformance.v1",
  "category": "replay-freshness",
  "cases": [
    {
      "caseId": "fresh-unseen-nonce-accepts",
      "description": "A current timestamp with a nonce not seen before is accepted.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "within-window-accepts",
      "description": "A timestamp 20 seconds in the past is inside the freshness window and is accepted.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-10T23:59:40.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "duplicate-nonce-rejects",
      "description": "A nonce already in previouslySeenNonces is a replay and is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": [
            "nonce-conformance-0001"
          ]
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "stale-timestamp-rejects",
      "description": "A timestamp older than the 5 minute age window is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-10T23:54:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "future-timestamp-rejects",
      "description": "A timestamp more than 30 seconds in the future is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:31.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "malformed-nonce-rejects",
      "description": "A nonce shorter than the minimum length is rejected before any freshness check.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "short",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "age-bound-accepts",
      "description": "The age bound is inclusive: a message exactly 300000 ms old is still fresh, because §3.5 rejects only when -drift EXCEEDS 300000.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-10T23:55:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "one-ms-past-age-bound-rejects",
      "description": "One millisecond older than the bound rejects, so an implementation with a longer window (or a wider unit) diverges here rather than passing on a coarse case.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-10T23:54:59.999Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "skew-bound-accepts",
      "description": "The future-skew bound is inclusive on the same reading: a message exactly 30000 ms ahead of the receiver clock is accepted.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:30.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "one-ms-past-skew-bound-rejects",
      "description": "One millisecond past the skew bound rejects, pinning the future edge to the millisecond the way the age edge is pinned.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:30.001Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "nonce-conformance-0001",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-16-units-accepts",
      "description": "A nonce of exactly 16 code units, the minimum length, is accepted.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAAA",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "nonce-15-units-rejects",
      "description": "A nonce of 15 code units, one short of the minimum, is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAA",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-256-units-accepts",
      "description": "A nonce of exactly 256 code units, the maximum length, is accepted.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "nonce-257-units-rejects",
      "description": "A nonce of 257 code units, one past the maximum, is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-plus-rejects",
      "description": "A nonce containing a `+` character is outside the [A-Za-z0-9_-] grammar and is rejected, even at an otherwise valid length.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAA+",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-padding-rejects",
      "description": "A nonce with a trailing base64 padding `=` character is outside the grammar and is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAA=",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-space-rejects",
      "description": "A nonce containing a space is outside the grammar and is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAA ",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "nonce-non-ascii-rejects",
      "description": "A nonce containing a non-ASCII character (U+00E9, e-acute) is outside the [A-Za-z0-9_-] grammar and is rejected.",
      "input": {
        "replay": {
          "messageTimestamp": "2026-06-11T00:00:00.000Z",
          "receiverClock": "2026-06-11T00:00:00.000Z",
          "nonce": "AAAAAAAAAAAAAAAé",
          "previouslySeenNonces": []
        }
      },
      "expect": {
        "result": "reject"
      }
    }
  ]
}
