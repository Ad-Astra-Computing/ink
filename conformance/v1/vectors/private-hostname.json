{
  "format": "ink.conformance.v1",
  "category": "private-hostname",
  "cases": [
    {
      "caseId": "public-dns",
      "description": "A public DNS name is accepted.",
      "input": {
        "hostname": "example.com"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "public-dns-uppercase",
      "description": "Case is normalized before classification.",
      "input": {
        "hostname": "EXAMPLE.COM"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "public-dns-trailing-dot",
      "description": "A trailing FQDN dot is stripped; the name stays public.",
      "input": {
        "hostname": "example.com."
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "public-ipv4",
      "description": "A public IPv4 literal is accepted.",
      "input": {
        "hostname": "8.8.8.8"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "public-ipv6",
      "description": "A public IPv6 literal is accepted.",
      "input": {
        "hostname": "2606:4700:4700::1111"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "public-ipv6-bracketed",
      "description": "A bracketed public IPv6 literal is accepted.",
      "input": {
        "hostname": "[2606:4700:4700::1111]"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "ipv4-mapped-dotted-public",
      "description": "An IPv4-mapped IPv6 of a public v4 is accepted.",
      "input": {
        "hostname": "::ffff:8.8.8.8"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "ipv4-mapped-hex-public",
      "description": "An IPv4-mapped IPv6 (hex form) of a public v4 is accepted.",
      "input": {
        "hostname": "::ffff:0808:0808"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "sixtofour-public",
      "description": "A 6to4 address embedding a public v4 is accepted.",
      "input": {
        "hostname": "2002:0808:0808::1"
      },
      "expect": {
        "result": "accept"
      }
    },
    {
      "caseId": "localhost",
      "description": "localhost is rejected.",
      "input": {
        "hostname": "localhost"
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "localhost-subdomain",
      "description": "A .localhost subdomain is rejected.",
      "input": {
        "hostname": "a.localhost"
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "localhost-trailing-dot-uppercase",
      "description": "A .localhost name is rejected after case and trailing-dot normalization.",
      "input": {
        "hostname": "A.LOCALHOST."
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "empty-after-strip",
      "description": "A name that is empty after stripping trailing dots is rejected.",
      "input": {
        "hostname": "."
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "dots-only",
      "description": "A dots-only name is rejected.",
      "input": {
        "hostname": "..."
      },
      "expect": {
        "result": "reject"
      }
    },
    {
      "caseId": "ipv4-private-10",
      "description": "10.0.0.0/8 is rejected.",
