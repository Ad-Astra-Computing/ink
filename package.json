{
  "name": "@adastracomputing/ink",
  "version": "0.1.0-alpha.1",
  "description": "Reference implementation and specification of the INK (Inter-agent Networking Kernel) protocol",
  "license": "MIT OR Apache-2.0",
  "author": "Ad Astra Computing Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ad-Astra-Computing/ink.git"
  },
  "homepage": "https://ink.tulpa.network",
  "bugs": {
    "url": "https://github.com/Ad-Astra-Computing/ink/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "specs/",
    "docs/",
    "test-vectors/",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "check:surface": "tsx scripts/check-public-surface.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^1.8.0",
    "canonicalize": "^2.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "ink",
    "agent-protocol",
    "ed25519",
    "atproto",
    "agent-to-agent",
    "reference-implementation"
  ]
}
